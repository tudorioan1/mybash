{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "template": " \uf007 {{ .UserName }}@{{ .HostName }} ",
          "foreground": "#ffffff",
          "background": "#3d3846"
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "template": " \uf07c {{ .Path }} ",
          "foreground": "#ffffff",
          "background": "#77767b"
        },
        {
          "type": "time",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "template": " \uf017 {{ .CurrentDate | date .Format }} ",
          "foreground": "#000000",
          "background": "#ffffff"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "template": " \uf252 {{ .FormattedMs }} ",
          "foreground": "#241f31",
          "background": "#9a9996"
        }
      ]
    }
  ],
  "palette": {
    "text-light": "#ffffff",
    "path-bg": "#61AFEF",
    "git-bg": "#98C379"
  }
}