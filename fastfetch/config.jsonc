{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "none",
    "padding": {
      "top": 1
    }
  },
  "display": {
  "separator": " - "
  },
  "modules": [
    "break",
    {
      "type": "os",
      "key": " Distribution",
      "keyColor": "yellow"
    },
    {
      "type": "uptime",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "keyColor": "yellow"
    },
    {
      "type": "command",
      "key": "OS Age",
      "keyColor": "yellow",
      "text": "birth_install=$(stat -c %W / 2>/dev/null || stat -f %B / 2>/dev/null || echo 0); case $birth_install in ''|0|-1) echo unknown;; *) current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days;; esac"
    },
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "keyColor": "blue"
    },
    {
      "type": "shell",
      "keyColor": "blue"
    },
    {
      "type": "host",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "format": "{2}",
      "keyColor": "green"
    },
    {
      "type": "display",
      "keyColor": "green",
      "compactType": "original-with-refresh-rate"
    },
    {
      "type": "memory",
      "key": "RAM",
      "keyColor": "green"
    },
    "break"
  ]
}
